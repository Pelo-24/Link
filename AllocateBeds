    public boolean allocateBed(int patientID){
        for(int rw = 0; rw < beds.length; rw++){
            for(int col = 0; col < beds[rw].length; col++){
                if (!beds[rw][col].IsOccupied){
                    beds[rw][col].IsOccupied = true;
                    beds[rw][col].PatientID = patientID;
                    return true;
                }
            }
        }
        return false;
    }

    
}
