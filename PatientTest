  @Test
  public void testRegisterPatient(){
      ArrayList<Patients> patientList = new ArrayList<>();
      
      Patients p = new Patients(1, "James", "Carter", 45, 1, "flu", 
              Patients.PatientCategory.inpatient);
      
      patientList.add(p);
      
      assertEquals(1, patientList.size());
      assertEquals(1, patientList.get(0).PatientID);
      assertEquals("James", patientList.get(0).FirstName);
      assertEquals("Carter", patientList.get(0).LastName);
      assertEquals(Patients.PatientCategory.inpatient,patientList.get(0).Category);
  }
    


